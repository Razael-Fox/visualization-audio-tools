# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Secret token used to verify incoming webhook requests from Telegram
WEBHOOK_SECRET=your_secret_token_here

# Port for the Express server to listen on
PORT=3000

# Visualizer API configuration (separate service, run with: pnpm visualizer)
# Bind to all interfaces (required for proot-distro networking)
VISUALIZER_HOST=0.0.0.0
VISUALIZER_PORT=8080
